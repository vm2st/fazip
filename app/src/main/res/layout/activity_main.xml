<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_version"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnSelectZip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_select_zip" />

    <TextView
        android:id="@+id/tvZipPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tv_zip_not_selected"
        android:layout_marginBottom="16dp"
        android:textSize="12sp"
        android:textColor="#888888" />

    <Button
        android:id="@+id/btnSelectDest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_select_dest" />

    <TextView
        android:id="@+id/tvDestPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tv_dest_not_selected"
        android:layout_marginBottom="32dp"
        android:textSize="12sp"
        android:textColor="#888888" />

    <Button
        android:id="@+id/btnExtract"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_extract"
        android:enabled="false"
        android:backgroundTint="#4CAF50" />

    <LinearLayout
        android:id="@+id/progressContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        android:gravity="center_horizontal"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/tvProgressPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvCurrentFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:textColor="#666666"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="middle"
            android:layout_marginTop="4dp"
            android:layout_marginHorizontal="16dp" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_stop"
            android:backgroundTint="#F44336"
            android:layout_marginTop="12dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnOpenReadme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/btn_readme_missing"
        android:enabled="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:padding="12dp"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

</LinearLayout>